# Managed by Ansible -- edit deploy/group_vars/all/vault.yml, not this file.
#
# systemd reads this with EnvironmentFile, which is not a shell: no quoting, no
# expansion, one KEY=value per line.

# Both environments serve a production build: staging stopped running
# `next dev` when it moved to CI-built artifacts.
NODE_ENV=production
PORT={{ item.port }}
HOSTNAME=127.0.0.1

NEXT_PUBLIC_AMPLITUDE_API_KEY={{ vault_next_public_amplitude_api_key }}
NEXT_PUBLIC_SENTRY_API_KEY={{ vault_next_public_sentry_api_key }}

BACKEND_SECRET={{ vault_backend_secret }}
BACKEND_AQICN_TOKEN={{ vault_backend_aqicn_token }}
BACKEND_GEOAPIFY_API_KEY={{ vault_backend_geoapify_api_key }}
BACKEND_MAILGUN_API_KEY={{ vault_backend_mailgun_api_key }}
BACKEND_MAILGUN_DOMAIN={{ vault_backend_mailgun_domain }}
BACKEND_OPENAQ_API_KEY={{ vault_backend_openaq_api_key }}
BACKEND_MONGODB_ATLAS_URI={{ item.mongodb_uri }}
