# Managed by Ansible. Staging serves a build shipped by the deploy workflow,
# the same way production does; see deploy/stage.sh.
[Unit]
Description=staging.shootismoke.app (next start)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ staging_user }}
WorkingDirectory={{ staging_dir }}
EnvironmentFile={{ staging_dir }}/.env
ExecStart=/usr/bin/npm run start -- --port {{ staging_port }} --hostname 127.0.0.1
Restart=always
RestartSec=5

# Staging runs the same server as production now, so it gets the same ceiling.
# Production still has to be the thing the OOM killer reaches for last.
MemoryHigh={{ staging_memory_high }}
MemoryMax={{ staging_memory_max }}

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Writable: a deployment swaps .next in place under this tree.
ReadWritePaths={{ staging_home }}
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
