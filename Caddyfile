# Caddy sits between Cloudflare and the Next server.
#
# TLS uses a Cloudflare Origin CA certificate rather than Let's Encrypt: with
# Cloudflare proxying the domain, the HTTP-01 challenge cannot reach us. Set the
# Cloudflare SSL/TLS mode to "Full (strict)" so the hop from Cloudflare to here
# is verified rather than merely encrypted.

{
	admin off
	email hi@shootismoke.app
}

(common) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Trust Cloudflare for the client IP. Without this every request looks like
	# it came from Cloudflare.
	request_header X-Real-IP {http.request.header.CF-Connecting-IP}
}

www.shootismoke.app {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	redir https://shootismoke.app{uri} permanent
}

shootismoke.app {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	import common

	# Next fingerprints everything under /_next/static, so it is safe to cache
	# hard. Cloudflare respects this at the edge.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Never let the edge cache the API.
	@api path /api/*
	header @api Cache-Control "no-store"

	reverse_proxy app:3000 {
		health_uri /api/health
		health_interval 30s
	}
}
